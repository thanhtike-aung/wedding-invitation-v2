---
import { closing, couple } from "../data/wedding";
---

<section class="section closing" aria-labelledby="closing-title">
  <div class="container closing-inner reveal reveal-scale">
    <span class="monogram" aria-hidden="true">A&amp;P</span>
    <h2 id="closing-title" class="closing-thanks">{closing.thanks}</h2>
    <p class="closing-message">{closing.message}</p>
    <p class="signoff">
      <span>{closing.signoff}</span>
      <span class="names">{couple.displayName}</span>
    </p>
  </div>
  <footer class="site-footer">
    <p>&copy; {new Date().getFullYear()} {couple.displayName}</p>
  </footer>
</section>

<style>
  .closing {
    padding-bottom: 2rem;
    text-align: center;
  }

  .closing-inner {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-bottom: clamp(3rem, 7vw, 4.5rem);
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--bronze);
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--bronze);
  }

  .closing-thanks {
    margin: 0.5rem 0 0;
    max-width: 30rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1.25;
  }

  .closing-message {
    max-width: 32rem;
    margin: 0;
    color: var(--charcoal);
  }

  .signoff {
    display: grid;
    gap: 0.1rem;
    margin: 1.25rem 0 0;
    color: var(--muted);
  }

  .signoff .names {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--espresso);
  }

  .site-footer {
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--rule);
    text-align: center;
    font-size: 0.8rem;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .site-footer p {
    margin: 0;
  }
</style>
