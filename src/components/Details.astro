---
import { details } from "../data/wedding";
---

<section class="section section-tint" id="details" aria-labelledby="details-title">
  <div class="container narrow">
    <div class="section-head reveal">
      <span class="eyebrow">Wedding Details</span>
      <h2 id="details-title" class="section-title">Join us in Yangon</h2>
    </div>

    <dl class="detail-list reveal reveal-scale">
      {
        details.map((item, index) => (
          <div class="detail reveal" style={`--delay:${index * 150}ms`}>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>

  </div>
</section>

<style>
  .section-tint {
    background: var(--cream);
  }

  .narrow {
    max-width: 36rem;
  }

  .detail-list {
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .detail {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .detail dt {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .detail dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
    text-align: right;
  }
</style>
