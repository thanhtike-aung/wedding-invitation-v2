---
import { couple, event, gallery, hero } from "../data/wedding";

const cards = [
  { src: gallery[3].thumb, alt: "" },
  { src: gallery[1].thumb, alt: "" },
  { src: hero.image, alt: hero.imageAlt },
];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-in hero-in-1">A decade together</p>
      <h1 id="hero-title" class="names hero-in hero-in-2">
        <span class="sr-only">Aung &amp; Phoo</span>
        <span class="lockup" aria-hidden="true">
          <svg class="sprigs" viewBox="0 0 577 433" focusable="false">
            <defs>
              <path id="leaf" d="M0 0Q18 -15 44 0Q18 15 0 0Z" fill="currentColor" fill-opacity="0.14" />
              <g id="sprig" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M323 34A200 185 0 0 1 487 262" stroke-width="2.6" />
                <use href="#leaf" transform="translate(372.6 48.4) rotate(63.4) scale(0.9)" />
                <use href="#leaf" transform="translate(372.6 48.4) rotate(-16.6) scale(0.9)" />
                <use href="#leaf" transform="translate(416.6 74.3) rotate(77.8) scale(1)" />
                <use href="#leaf" transform="translate(416.6 74.3) rotate(-2.2) scale(1)" />
                <use href="#leaf" transform="translate(451.8 109.8) rotate(92.8) scale(1.05)" />
                <use href="#leaf" transform="translate(451.8 109.8) rotate(12.8) scale(1.05)" />
                <use href="#leaf" transform="translate(476.8 153.7) rotate(108.5) scale(1)" />
                <use href="#leaf" transform="translate(476.8 153.7) rotate(28.5) scale(1)" />
                <use href="#leaf" transform="translate(487 199.9) rotate(124.6) scale(0.95)" />
                <use href="#leaf" transform="translate(487 199.9) rotate(44.6) scale(0.95)" />
                <circle cx="338" cy="36" r="5" />
                <circle cx="350" cy="45" r="4" />
                <circle cx="330" cy="46" r="3.5" />
              </g>
            </defs>
            <use href="#sprig" />
            <use href="#sprig" transform="matrix(-1 0 0 -1 576 432)" />
          </svg>
          <span class="name name-aung">Aung</span>
          <span class="name name-phoo">Phoo</span>
          <span class="heart" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false">
              <path d="M12 21C12 21 3 15.5 3 9.5 3 6.4 5.4 4 8.3 4 10 4 11.3 4.9 12 6.1 12.7 4.9 14 4 15.7 4 18.6 4 21 6.4 21 9.5 21 15.5 12 21 12 21Z" />
            </svg>
          </span>
        </span>
      </h1>
      <p class="hero-message hero-in hero-in-3">
        Together with our families, we invite you to celebrate our wedding.
      </p>
      <p class="hero-date hero-in hero-in-3">
        <time datetime="2026-11-29">{event.dateLabel}</time>
        <span class="sep" aria-hidden="true">·</span>
        <span>{event.city}, Myanmar</span>
      </p>

      <div class="hero-actions hero-in hero-in-4">
        <a class="btn btn-solid" href="#journey">Explore the invitation</a>
      </div>
    </div>

    <figure class="hero-media">
      <div class="tilt" data-tilt>
        <div class="frame" data-parallax>
          {
            cards.map((card, index) => (
              <div class={`card card-${index}`}>
                <img
                  src={card.src}
                  alt={card.alt}
                  width="600"
                  height="750"
                  loading="eager"
                  decoding="async"
                />
              </div>
            ))
          }
          <span class="floor" aria-hidden="true"></span>
        </div>
      </div>
    </figure>
  </div>

  <div class="container countdown-wrap hero-in hero-in-4" data-countdown data-target={event.ceremonyStartsAt}>
    <p class="countdown-title" data-countdown-title>Counting down to the ceremony</p>
    <ul class="countdown" aria-label="Time remaining until the ceremony" data-countdown-units>
      <li><span class="num" data-unit="days">--</span><span class="unit">Days</span></li>
      <li><span class="num" data-unit="hours">--</span><span class="unit">Hours</span></li>
      <li><span class="num" data-unit="minutes">--</span><span class="unit">Minutes</span></li>
      <li><span class="num" data-unit="seconds">--</span><span class="unit">Seconds</span></li>
    </ul>
    <p class="countdown-note">{couple.displayName} · 5:30 PM, Yangon time</p>
  </div>
</section>

<script>
  const frame = document.querySelector<HTMLElement>("[data-parallax]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const tilt = document.querySelector<HTMLElement>("[data-tilt]");
  const canTilt = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  if (tilt && canTilt && !reduceMotion) {
    tilt.addEventListener("pointermove", (event) => {
      const rect = tilt.parentElement!.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      tilt.style.setProperty("--ry", `${(x * 24).toFixed(2)}deg`);
      tilt.style.setProperty("--rx", `${(-y * 24).toFixed(2)}deg`);
    });

    tilt.addEventListener("pointerleave", () => {
      tilt.style.setProperty("--rx", "0deg");
      tilt.style.setProperty("--ry", "0deg");
    });
  }

  if (frame && !reduceMotion) {
    const onScroll = () => {
      const offset = Math.min(window.scrollY, 600);
      frame.style.setProperty("--py", `${offset * -0.06}px`);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const root = document.querySelector<HTMLElement>("[data-countdown]");

  if (root) {
    const target = new Date(root.dataset.target ?? "").getTime();
    const units = root.querySelector<HTMLElement>("[data-countdown-units]");
    const title = root.querySelector<HTMLElement>("[data-countdown-title]");
    const pad = (n: number) => String(n).padStart(2, "0");

    const tick = () => {
      const diff = target - Date.now();

      if (diff <= 0) {
        if (title) title.textContent = "Today we celebrate";
        units?.setAttribute("hidden", "");
        if (timer !== undefined) window.clearInterval(timer);
        return;
      }

      const total = Math.floor(diff / 1000);
      const values = {
        days: Math.floor(total / 86400),
        hours: Math.floor((total % 86400) / 3600),
        minutes: Math.floor((total % 3600) / 60),
        seconds: total % 60,
      };

      (Object.keys(values) as (keyof typeof values)[]).forEach((key) => {
        const el = root.querySelector<HTMLElement>(`[data-unit="${key}"]`);
        if (!el) return;
        const next = key === "days" ? String(values.days) : pad(values[key]);
        if (el.textContent === next) return;
        el.textContent = next;
        el.classList.remove("is-ticking");
        void el.offsetWidth;
        el.classList.add("is-ticking");
      });
    };

    let timer: number | undefined;
    tick();
    if (Date.now() < target) timer = window.setInterval(tick, 1000);
  }
</script>

<style>
  .hero {
    position: relative;
    padding: calc(var(--header-h) + 2.5rem) 0 3.5rem;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-copy {
    text-align: center;
  }

  .names {
    margin: 0 0 1.25rem;
    font-weight: 400;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .lockup {
    position: relative;
    display: block;
    width: min(440px, 88vw);
    aspect-ratio: 577 / 433;
    margin: 0 auto;
    container-type: inline-size;
    color: var(--bronze);
  }

  .sprigs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .name {
    position: absolute;
    margin: 0;
    font-family: "Allura", "Pinyon Script", cursive;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .name-aung {
    left: 19%;
    top: 13%;
    font-size: 25cqw;
    animation: nameRise 1.2s var(--ease) both;
  }

  .name-phoo {
    left: 38%;
    top: 50%;
    font-size: 23cqw;
    animation: nameRise 1.2s var(--ease) 0.2s both;
  }

  .heart {
    position: absolute;
    left: 50%;
    top: 45%;
    width: 11cqw;
    transform: translate(-50%, -50%);
  }

  .heart svg {
    display: block;
    width: 100%;
    height: auto;
    fill: currentColor;
  }

  .hero-message {
    max-width: 30rem;
    margin: 0 auto 1.25rem;
    color: var(--charcoal);
    font-size: clamp(1.02rem, 2.2vw, 1.15rem);
  }

  .hero-date {
    margin: 0 0 2rem;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .sep {
    margin: 0 0.5rem;
    color: var(--bronze);
  }

  .hero-media {
    margin: 0 auto;
    width: min(340px, 78vw);
    perspective: 1000px;
  }

  .tilt {
    --rx: 0deg;
    --ry: 0deg;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    transition: transform 0.6s var(--ease);
    animation: floatY 7s ease-in-out 2.5s infinite;
  }

  @keyframes floatY {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    transform: translateY(var(--py, 0px));
    transform-style: preserve-3d;
    will-change: transform;
    --s: 1;
  }

  .frame:hover {
    --s: 1.35;
  }

  .card {
    --x: 0%;
    --z: 0px;
    --r: 0deg;
    --rz: 0deg;
    --delay: 0s;
    position: absolute;
    inset: 6%;
    border: 6px solid var(--paper);
    border-radius: 14px;
    overflow: hidden;
    background: var(--cream);
    box-shadow: 0 24px 40px -18px rgba(46, 36, 32, 0.5);
    transform: translate3d(calc(var(--x) * var(--s)), 0, calc(var(--z) * var(--s)))
      rotateY(calc(var(--r) * var(--s))) rotateZ(var(--rz));
    transition: transform 0.9s var(--ease);
    animation: cardIn 1.8s var(--ease) var(--delay) backwards;
  }

  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-0 {
    --x: 24%;
    --z: -100px;
    --r: 14deg;
    --rz: 4deg;
    --delay: 0.35s;
  }

  .card-1 {
    --x: -20%;
    --z: -50px;
    --r: -10deg;
    --rz: -3deg;
    --delay: 0.2s;
  }

  .card-2 {
    --x: 0%;
    --z: 40px;
    --r: 0deg;
    --rz: 0deg;
    --delay: 0.05s;
  }

  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translate3d(0, 0, -260px) rotateY(70deg);
    }
    to {
      opacity: 1;
    }
  }

  .floor {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -4%;
    height: 12%;
    background: radial-gradient(ellipse at center, rgba(46, 36, 32, 0.35), transparent 70%);
    translate: 0 0 -140px;
    pointer-events: none;
  }

  .countdown-wrap {
    margin-top: clamp(2.5rem, 6vw, 3.75rem);
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    text-align: center;
  }

  .countdown-title {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .countdown {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .countdown[hidden] {
    display: none;
  }

  .countdown li {
    display: grid;
    min-width: 4.6rem;
    padding: 0.85rem 0.6rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--paper);
  }

  .num {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .num.is-ticking {
    animation: tick 0.45s var(--ease);
  }

  .unit {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .countdown-note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .hero-in {
    animation: rise 1s var(--ease) both;
  }

  .hero-in-1 {
    animation-delay: 0.1s;
  }

  .hero-in-2 {
    animation-delay: 0.25s;
  }

  .hero-in-3 {
    animation-delay: 0.45s;
  }

  .hero-in-4 {
    animation-delay: 0.65s;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
  }

  @keyframes nameRise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes tick {
    from {
      opacity: 0.25;
      transform: translateY(-0.3em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }

    .hero-copy {
      text-align: left;
    }

    .hero-message {
      margin-left: 0;
    }

    .lockup {
      margin-left: 0;
    }

    .hero-actions {
      justify-content: flex-start;
    }

    .hero-media {
      width: min(440px, 100%);
      margin-right: 0;
    }

    .countdown-wrap {
      text-align: left;
    }

    .countdown {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .name,
    .num.is-ticking,
    .card,
    .tilt {
      animation: none;
    }

    .card {
      transition: none;
    }

    .tilt {
      transform: none;
    }

    .frame {
      transform: none;
    }

    .frame:hover {
      --s: 1;
    }
  }
</style>
