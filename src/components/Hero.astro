---
import { couple, event, hero } from "../data/wedding";
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow hero-in hero-in-1">A decade together</p>
      <h1 id="hero-title" class="names hero-in hero-in-2">
        <span class="sr-only">Aung &amp; Phoo</span>
        <span class="lockup" aria-hidden="true">
          <svg class="sprigs" viewBox="0 0 577 433" focusable="false">
            <defs>
              <path id="leaf" d="M0 0Q18 -15 44 0Q18 15 0 0Z" fill="currentColor" fill-opacity="0.14" />
              <g id="sprig" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M323 34A200 185 0 0 1 487 262" stroke-width="2.6" />
                <use href="#leaf" transform="translate(372.6 48.4) rotate(63.4) scale(0.9)" />
                <use href="#leaf" transform="translate(372.6 48.4) rotate(-16.6) scale(0.9)" />
                <use href="#leaf" transform="translate(416.6 74.3) rotate(77.8) scale(1)" />
                <use href="#leaf" transform="translate(416.6 74.3) rotate(-2.2) scale(1)" />
                <use href="#leaf" transform="translate(451.8 109.8) rotate(92.8) scale(1.05)" />
                <use href="#leaf" transform="translate(451.8 109.8) rotate(12.8) scale(1.05)" />
                <use href="#leaf" transform="translate(476.8 153.7) rotate(108.5) scale(1)" />
                <use href="#leaf" transform="translate(476.8 153.7) rotate(28.5) scale(1)" />
                <use href="#leaf" transform="translate(487 199.9) rotate(124.6) scale(0.95)" />
                <use href="#leaf" transform="translate(487 199.9) rotate(44.6) scale(0.95)" />
                <circle cx="338" cy="36" r="5" />
                <circle cx="350" cy="45" r="4" />
                <circle cx="330" cy="46" r="3.5" />
              </g>
            </defs>
            <use href="#sprig" />
            <use href="#sprig" transform="matrix(-1 0 0 -1 576 432)" />
          </svg>
          <span class="name name-aung">Aung</span>
          <span class="name name-phoo">Phoo</span>
        </span>
      </h1>
      <p class="hero-message hero-in hero-in-3">
        Together with our families, we invite you to celebrate our wedding.
      </p>
      <p class="hero-date hero-in hero-in-3">
        <time datetime="2026-11-29">{event.dateLabel}</time>
        <span class="sep" aria-hidden="true">·</span>
        <span>{event.city}, Myanmar</span>
      </p>

      <div class="hero-actions hero-in hero-in-4">
        <a class="btn btn-solid" href="#journey">Explore the invitation</a>
      </div>
    </div>

    <figure class="hero-media hero-in hero-in-2">
      <div class="frame" data-parallax>
        <div class="photo">
          <img
          src={hero.image}
          alt={hero.imageAlt}
          width="1800"
          height="1200"
          fetchpriority="high"
          decoding="async"
          class="hero-img"
        />
        </div>
      </div>
    </figure>
  </div>

  <div class="container countdown-wrap hero-in hero-in-4" data-countdown data-target={event.ceremonyStartsAt}>
    <p class="countdown-title" data-countdown-title>Counting down to the ceremony</p>
    <ul class="countdown" aria-label="Time remaining until the ceremony" data-countdown-units>
      <li><span class="num" data-unit="days">--</span><span class="unit">Days</span></li>
      <li><span class="num" data-unit="hours">--</span><span class="unit">Hours</span></li>
      <li><span class="num" data-unit="minutes">--</span><span class="unit">Minutes</span></li>
      <li><span class="num" data-unit="seconds">--</span><span class="unit">Seconds</span></li>
    </ul>
    <p class="countdown-note">{couple.displayName} · 5:30 PM, Yangon time</p>
  </div>
</section>

<script>
  const frame = document.querySelector<HTMLElement>("[data-parallax]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (frame && !reduceMotion) {
    const onScroll = () => {
      const offset = Math.min(window.scrollY, 600);
      frame.style.setProperty("--py", `${offset * -0.06}px`);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  const root = document.querySelector<HTMLElement>("[data-countdown]");

  if (root) {
    const target = new Date(root.dataset.target ?? "").getTime();
    const units = root.querySelector<HTMLElement>("[data-countdown-units]");
    const title = root.querySelector<HTMLElement>("[data-countdown-title]");
    const pad = (n: number) => String(n).padStart(2, "0");

    const tick = () => {
      const diff = target - Date.now();

      if (diff <= 0) {
        if (title) title.textContent = "Today we celebrate";
        units?.setAttribute("hidden", "");
        if (timer !== undefined) window.clearInterval(timer);
        return;
      }

      const total = Math.floor(diff / 1000);
      const values = {
        days: Math.floor(total / 86400),
        hours: Math.floor((total % 86400) / 3600),
        minutes: Math.floor((total % 3600) / 60),
        seconds: total % 60,
      };

      (Object.keys(values) as (keyof typeof values)[]).forEach((key) => {
        const el = root.querySelector<HTMLElement>(`[data-unit="${key}"]`);
        if (!el) return;
        const next = key === "days" ? String(values.days) : pad(values[key]);
        if (el.textContent === next) return;
        el.textContent = next;
        el.classList.remove("is-ticking");
        void el.offsetWidth;
        el.classList.add("is-ticking");
      });
    };

    let timer: number | undefined;
    tick();
    if (Date.now() < target) timer = window.setInterval(tick, 1000);
  }
</script>

<style>
  .hero {
    position: relative;
    padding: calc(var(--header-h) + 2.5rem) 0 3.5rem;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .hero-copy {
    text-align: center;
  }

  .names {
    margin: 0 0 1.25rem;
    font-weight: 400;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .lockup {
    position: relative;
    display: block;
    width: min(440px, 88vw);
    aspect-ratio: 577 / 433;
    margin: 0 auto;
    container-type: inline-size;
    color: var(--bronze);
  }

  .sprigs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .name {
    position: absolute;
    margin: 0;
    font-family: "Allura", "Pinyon Script", cursive;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .name-aung {
    left: 19%;
    top: 13%;
    font-size: 25cqw;
  }

  .name-phoo {
    left: 38%;
    top: 50%;
    font-size: 23cqw;
  }

  .hero-message {
    max-width: 30rem;
    margin: 0 auto 1.25rem;
    color: var(--charcoal);
    font-size: clamp(1.02rem, 2.2vw, 1.15rem);
  }

  .hero-date {
    margin: 0 0 2rem;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .sep {
    margin: 0 0.5rem;
    color: var(--bronze);
  }

  .hero-media {
    margin: 0 auto;
    width: min(340px, 78vw);
  }

  .frame {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    padding: 10px;
    border: 1px solid var(--bronze);
    transform: translateY(var(--py, 0px));
    will-change: transform;
  }

  .frame::after {
    content: "";
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 1px dashed rgba(142, 106, 67, 0.35);
    pointer-events: none;
    animation: ringTurn 40s linear infinite;
  }

  .name-aung {
    animation: nameRise 1.2s var(--ease) both;
  }

  .name-phoo {
    animation: nameRise 1.2s var(--ease) 0.2s both;
  }

  .num.is-ticking {
    animation: tick 0.45s var(--ease);
  }

  @keyframes nameRise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes tick {
    from {
      opacity: 0.25;
      transform: translateY(-0.3em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes ringTurn {
    to {
      transform: rotate(360deg);
    }
  }

  .photo {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
    isolation: isolate;
  }

  .photo::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 18%, rgba(251, 247, 240, 0.22), transparent 55%),
      linear-gradient(180deg, rgba(162, 90, 64, 0.1) 0%, rgba(46, 36, 32, 0.12) 55%, rgba(46, 36, 32, 0.5) 100%);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .photo::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(251, 247, 240, 0.35), inset 0 -60px 80px -40px rgba(46, 36, 32, 0.45);
    pointer-events: none;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--cream);
    animation: heroFade 1.6s var(--ease) both;
  }

  .countdown-wrap {
    margin-top: clamp(2.5rem, 6vw, 3.75rem);
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    text-align: center;
  }

  .countdown-title {
    margin: 0 0 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .countdown {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .countdown[hidden] {
    display: none;
  }

  .countdown li {
    display: grid;
    min-width: 4.6rem;
    padding: 0.85rem 0.6rem 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 14px;
    background: var(--paper);
  }

  .num {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .unit {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .countdown-note {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .hero-in {
    animation: rise 1s var(--ease) both;
  }

  .hero-in-1 {
    animation-delay: 0.1s;
  }

  .hero-in-2 {
    animation-delay: 0.25s;
  }

  .hero-in-3 {
    animation-delay: 0.45s;
  }

  .hero-in-4 {
    animation-delay: 0.65s;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes heroFade {
    from {
      opacity: 0;
      transform: scale(1.04);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 860px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }

    .hero-copy {
      text-align: left;
    }

    .hero-message {
      margin-left: 0;
    }

    .lockup {
      margin-left: 0;
    }

    .hero-actions {
      justify-content: flex-start;
    }

    .hero-media {
      width: min(440px, 100%);
      margin-right: 0;
    }

    .countdown-wrap {
      text-align: left;
    }

    .countdown {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .hero-in,
    .name,
    .num.is-ticking,
    .frame::after {
      animation: none;
    }

    .frame {
      transform: none;
    }
  }
</style>
