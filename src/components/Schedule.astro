---
import { schedule } from "../data/wedding";
---

<section class="section" id="schedule" aria-labelledby="schedule-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Schedule</span>
      <h2 id="schedule-title" class="section-title">An evening in four moments</h2>
      <p class="lead">Arrive → Ceremony → Celebrate → Farewell</p>
    </div>

    <ol class="timeline reveal">
      {
        schedule.map((step, index) => (
          <li class="step reveal reveal-left" style={`--delay:${index * 200}ms`}>
            <span class="step-dot" aria-hidden="true"></span>
            <p class="step-time">{step.time}</p>
            <h3 class="step-title">{step.title}</h3>
            <p class="step-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 0 0 2rem;
    list-style: none;
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--rose), var(--bronze));
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.8s var(--ease) 0.2s;
  }

  .timeline.is-visible::before {
    transform: scaleY(1);
  }

  .step.is-visible .step-dot {
    animation: dotPop 0.7s var(--ease) both;
    animation-delay: calc(var(--delay, 0ms) + 0.3s);
  }

  @keyframes dotPop {
    0% {
      transform: scale(0.2);
      opacity: 0;
    }
    70% {
      transform: scale(1.25);
      opacity: 1;
    }
    100% {
      transform: scale(1);
    }
  }

  .step {
    position: relative;
    padding-bottom: 2.4rem;
  }

  .step:last-child {
    padding-bottom: 0;
  }

  .step-dot {
    position: absolute;
    left: -2rem;
    top: 0.45rem;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 1px solid var(--bronze);
    background: var(--ivory);
    transform: translateX(0);
  }

  .step-dot::after {
    content: "";
    position: absolute;
    inset: 2px;
    border-radius: 50%;
    background: var(--terracotta);
  }

  .step-time {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sage);
  }

  .step-title {
    margin: 0.2rem 0 0.35rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.1rem);
    line-height: 1.2;
  }

  .step-body {
    margin: 0;
    color: var(--charcoal);
  }
</style>
